{
  "name": "vault-wars-netlify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build && node scripts/package-function.mjs",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:package"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.7"
  },
  "devDependencies": {
    "@netlify/functions": "^5.0.0",
    "@netlify/zip-it-and-ship-it": "16.6.0",
    "@types/node": "^22.0.0",
    "fflate": "0.8.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
